# Reverse proxy + automatic HTTPS (Let's Encrypt) for the chatbot subdomain.
# Backend routes are already prefixed /api/* (see backend/app/main.py), so no
# path rewriting is needed — Caddy just splits traffic by path prefix.
chatbot.bucketlistt.com {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
