# Reverse proxy + automatic HTTPS (Let's Encrypt) for the chatbot subdomain.
# Backend-only — client wants chatbot.bucketlistt.com to serve the API,
# not a standalone chat UI (the frontend embeds elsewhere, e.g. as a widget
# on the main site). Backend routes are already prefixed /api/* (see
# backend/app/main.py), so this just forwards everything as-is.
chatbot.bucketlistt.com {
	reverse_proxy backend:8000
}
